{
  "name": "splitlink-studio-local-release",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5274",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4274",
    "test": "bun test tests/*.test.ts",
    "test:browser": "playwright test",
    "contracts:test": "forge test",
    "contracts:build": "forge build",
    "compile": "node scripts/compile.mjs",
    "local:chain": "anvil --host 127.0.0.1 --port 9547 --chain-id 31338",
    "local:deploy": "node scripts/local-deploy.mjs",
    "audit": "pnpm audit --audit-level high",
    "format:check": "prettier --check src scripts tests *.ts *.json",
    "test:local": "bun test tests/local/*.test.ts",
    "ci:local": "node scripts/ci-local.mjs"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.1.0",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.4",
    "viem": "2.56.3"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/node": "24.3.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/bun": "1.3.10",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.2",
    "vite": "6.4.4",
    "solc": "0.8.28",
    "prettier": "3.6.2",
    "bun": "1.4.3",
    "@foundry-rs/forge": "1.7.1",
    "@foundry-rs/anvil": "1.7.1"
  }
}
